{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "mcp__context7"
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
