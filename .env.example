# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Read-only database role for inspection tools (docker-compose only, not used by the app)
POSTGRES_READONLY_USER=mcp_readonly
POSTGRES_READONLY_PASSWORD=readonly

# Mailpit (docker-compose only): SMTP and web UI ports on localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
